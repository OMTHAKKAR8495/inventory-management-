# ==============================================================================
# ProvisionSmart — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT session cookies (HS256).
# In production, use a strong 32+ character random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=wholesale-provision-store-super-secure-key-2026-xyz-9988

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Dual-Engine Architecture)
# ------------------------------------------------------------------------------
# ProvisionSmart supports a seamless dual-storage model:
#   A) Cloud PostgreSQL (Supabase / Neon / AWS RDS)
#      Provide a valid connection string below.
#      Note: For Supabase on serverless/Vercel, use the IPv4 transaction pooler
#      on port 6543 to prevent connection exhaustion.
#
#   B) Local SQLite Fallback
#      If DATABASE_URL is left empty or commented out, the application will
#      automatically fall back to local SQLite at `./data/inventory.db` using WAL mode.
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Optional Client-side Supabase references (if using direct Supabase storage/auth features)
NEXT_PUBLIC_SUPABASE_URL=https://yourprojectref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development
